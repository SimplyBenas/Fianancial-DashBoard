# Google Sheets Service Account Credentials
# NEVER commit the real .env file to version control!

# 1. L'email del Service Account (la trovi nel file JSON scaricato da Google Cloud)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com

# 2. La chiave privata del Service Account (copiala dal campo "private_key" del file JSON)
#    Importante: incollala tutta su UNA sola riga, i \n verranno gestiti automaticamente
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...tua-chiave-qui...\n-----END PRIVATE KEY-----\n"

# 3. L'ID del tuo foglio Google Sheets
#    Lo trovi nell'URL: https://docs.google.com/spreadsheets/d/QUESTO_E_L_ID/edit
GOOGLE_SPREADSHEET_ID=1234567890abcdef

# 4. Porta del server (opzionale, default: 3001)
PORT=3001
